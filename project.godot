; Engine configuration file.
config_version=5

[application]

config/name="Strata Bohemica"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://museum/ui/brand/mark.png"
run/main_scene="res://museum/app/museum_village.tscn"
boot_splash/bg_color=Color(0.1176, 0.098, 0.0784, 1)
boot_splash/image="res://museum/ui/brand/mark.png"
boot_splash/fullsize=false

[audio]

; Explicit on purpose: this is also Godot's default path, so deleting the line changes nothing and no test could notice.
; What is guarded is the file itself: test_sound.gd reads the bus names and sends from AudioServer at startup (the layout really loaded).
buses/default_bus_layout="res://default_bus_layout.tres"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[importer_defaults]

texture={
"compress/mode": 1,
"compress/lossy_quality": 0.95,
"mipmaps/generate": false,
"detect_3d/compress_to": 0
}
