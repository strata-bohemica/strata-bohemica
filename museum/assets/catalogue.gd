extends RefCounted
## Asset catalogue: "ASSET-ID/model_name" -> resource path, clip lengths, anchors.
## Backed by museum/data/assets.json, generated by tools/sync_assets.py. Code never builds asset paths itself,
## so a new factory revision changes the catalogue, not the code.

const Schema = preload("res://museum/core/schema.gd")
const ASSETS_JSON := "res://museum/data/assets.json"

static var _data: Dictionary = {}

static func _ensure() -> void:
	if _data.is_empty():
		var loaded: Variant = Schema.load_json(ASSETS_JSON)
		_data = loaded if loaded is Dictionary else {}

static func model(ref: String) -> Dictionary:
	_ensure()
	var parts := ref.split("/")
	if parts.size() != 2:
		return {}
	var asset: Dictionary = _data.get(parts[0], {})
	return asset.get("models", {}).get(parts[1], {})

static func has_model(ref: String) -> bool:
	return not model(ref).is_empty()

static func path(ref: String) -> String:
	return "res://assets/" + str(model(ref).get("file", ""))

static func clip_lengths(ref: String) -> Dictionary:
	return model(ref).get("animations", {})

## Anchor from the asset's own asset.json: {"pos": Vector3, "yaw": float (radians)}.
static func anchor(ref: String, anchor_name: String) -> Dictionary:
	var a: Dictionary = model(ref).get("anchors", {}).get(anchor_name, {})
	if a.is_empty():
		return {}
	var t: Array = a.translation
	return {"pos": Vector3(float(t[0]), float(t[1]), float(t[2])), "yaw": deg_to_rad(float(a.get("yaw_deg", 0.0)))}

static func instantiate(ref: String) -> Node3D:
	var scene := load(path(ref)) as PackedScene
	return null if scene == null else scene.instantiate() as Node3D
